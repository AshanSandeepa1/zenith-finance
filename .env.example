# Supabase Postgres — Project Settings → Database → Connection string.
# DATABASE_URL: pooled connection (port 6543) — used at runtime by serverless functions.
#   pgbouncer=true is required: Supabase's pooler runs in transaction mode, which
#   doesn't support prepared statements — Prisma throws "prepared statement already
#   exists" (42P05) without this flag.
# DIRECT_URL: direct connection (port 5432) — used by `prisma migrate` / `prisma db seed`.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — Google Cloud Console OAuth 2.0 credentials for Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# USD -> LKR display rate used by the currency toggle.
NEXT_PUBLIC_USD_LKR_RATE="298.50"
